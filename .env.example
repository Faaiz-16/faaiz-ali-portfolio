# Copy to .env.local and restart the dev server. Never commit real values.
# VITE_ variables are bundled into the client JavaScript and are public, so
# only put values here that are safe to expose (no private keys or tokens).

# Optional contact form endpoint (Formspree, Web3Forms or Getform).
# Leave empty to show email/social contact cards instead of a form.
# Web3Forms also needs an "access_key" hidden input in Contact.tsx.
VITE_CONTACT_ENDPOINT=
